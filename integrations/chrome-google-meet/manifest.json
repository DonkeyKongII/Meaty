{
  "manifest_version": 3,
  "name": "Meetily \u2014 Google Meet Auto Start",
  "version": "0.4.0",
  "description": "Automatically start and stop local Meetily recording with Google Meet calls.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
